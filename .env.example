# CPIM-MES development configuration.
# Copy to .env only for local development; do not use these values in production.
APP_ENV=development
# The backend connects as the least-privilege application role (user cpim_app).
DATABASE_URL=postgres://cpim_app:cpim_app@db:5432/cpim?sslmode=disable
# Used only by the one-shot migrate service: the owner/admin connection, and the
# password it sets on cpim_app (must match DATABASE_URL).
MIGRATION_DATABASE_URL=postgres://cpim:cpim@db:5432/cpim?sslmode=disable
APP_DB_PASSWORD=cpim_app
JWT_SECRET=dev-secret-change-me-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
LOGIN_RATE_LIMIT_WINDOW=15m
LOGIN_RATE_LIMIT_IP_MAX_FAILURES=30
LOGIN_RATE_LIMIT_USERNAME_MAX_FAILURES=5
MIGRATION_TIMEOUT=10m
MIGRATION_INSTALLED_BY=docker-compose-migrate

# Fixed demo credentials no longer exist. On an empty users table, configure
# the initial administrator explicitly. The password itself must be in a file.
# For Docker Compose, see docker-compose.bootstrap.yml.
# BOOTSTRAP_ADMIN_USERNAME=initial-admin
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password

# Observability. /metrics is always served by the backend on its internal port.
# OTLP tracing is disabled unless OTEL_EXPORTER_OTLP_ENDPOINT is set.
# The built-in exporter uses OTLP/HTTP JSON and appends /v1/traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer-example
OTEL_SERVICE_NAME=cpim-mes-backend
OTEL_EXPORT_TIMEOUT=5s
OTEL_BSP_MAX_QUEUE_SIZE=256

# Business calendar timezone (IANA name) used for planning dates. Must match the
# database setting app.business_timezone (both default to Asia/Tokyo).
# Compose passes this to the backend only. When you change it, also run
#   ALTER DATABASE <db> SET app.business_timezone = '<same IANA name>';
# and restart the backend, otherwise Go and PostgreSQL disagree on "today".
# The backend refuses to start when the two differ.
# BUSINESS_TIMEZONE=Asia/Tokyo
