# Production template. Replace every CHANGE_ME value through your deployment
# secret/config mechanism. Do not commit a populated production .env file.
# Production Compose topology (Step 4). Keep this file as a template only.
POSTGRES_USER=cpim
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cpim
CPIM_HTTP_PORT=8080
APP_ENV=production
DATABASE_URL=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Empty means no cross-origin browser access (same-origin only).
# For multiple explicit origins, use a comma-separated allow-list.
ALLOWED_ORIGINS=
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict
LOGIN_RATE_LIMIT_WINDOW=15m
LOGIN_RATE_LIMIT_IP_MAX_FAILURES=30
LOGIN_RATE_LIMIT_USERNAME_MAX_FAILURES=5
MIGRATION_TIMEOUT=10m
MIGRATION_INSTALLED_BY=production-backend

# Required only when the users table is empty. The backend refuses to start on
# an empty users table unless both are configured. Never put the password itself
# in an environment variable.
# BOOTSTRAP_ADMIN_USERNAME=initial-admin
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password

# Observability. Prometheus should scrape backend:8080/metrics from the private
# application network; the production Nginx does not publish /metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer-CHANGE_ME
OTEL_SERVICE_NAME=cpim-mes-backend
OTEL_EXPORT_TIMEOUT=5s
OTEL_BSP_MAX_QUEUE_SIZE=256

# Step 11 backup/restore tools operate through the private Compose DB service.
# Invoke them with this env file explicitly, for example:
#   CPIM_ENV_FILE=.env.production ./scripts/backup_postgres.sh
#   CPIM_ENV_FILE=.env.production ./scripts/restore_drill.sh
# Backup files contain business data and belong in an encrypted, off-site/separate-failure-domain store.

# Business calendar timezone (IANA name) used for planning dates. Must match the
# database setting app.business_timezone (both default to Asia/Tokyo).
# BUSINESS_TIMEZONE=Asia/Tokyo
